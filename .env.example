# 本文件会被服务自动读取（复制为同目录 .env 即可生效）。
# 优先级：**进程环境变量 > .env 文件**。CI 与服务管理器注入的值永不被覆盖。
# 自定义 .env 路径：设置 LIVE_AGENT_ENV_FILE（便携部署 / 企业受控目录常用）。
# 完全关闭 .env 加载：LIVE_AGENT_DISABLE_DOTENV=1

# ---------------------------------------------------------------------------
# 基础服务配置
# ---------------------------------------------------------------------------
LIVE_AGENT_DATA_DIR=./data
LIVE_AGENT_HOST=127.0.0.1
LIVE_AGENT_PORT=18080
LIVE_AGENT_LOG_LEVEL=INFO
LIVE_AGENT_LOG_MAX_BYTES=5242880
LIVE_AGENT_LOG_BACKUP_COUNT=5
LIVE_AGENT_AV_DELAY_MS=0
LIVE_AGENT_RENDER_BACKEND=procedural

# ---------------------------------------------------------------------------
# 安全与鉴权（商用必读）
# ---------------------------------------------------------------------------
# 运行档位：DEMO / PREVIEW / PILOT / PRODUCTION（默认 DEMO）
#   PILOT 与 PRODUCTION 为「商业档位」，此时**本机回环也强制校验令牌**，
#   与 WebSocket 守卫保持同一强度（历史上 HTTP 侧缺此判断，导致
#   「WebSocket 已锁死、REST API 全开」的安全倒挂，现已修正）。
#
#   ⚠ 启用商业档位前必须先配置 API_AUTH_TOKEN，否则服务会拒绝一切业务请求
#     （fail-closed，这是刻意设计：宁可不播，也绝不用默认弱配置对外服务）。
#   本文件默认保持注释，避免直接复制本文件后得到一个「全部 403」的实例。
# LIVE_AGENT_MODE=PRODUCTION

# 外部访问统一鉴权令牌：商业档位下所有非探针请求必须携带
# Authorization: Bearer <token> 或 X-API-Key（Cookie access_token 亦可）
# API_AUTH_TOKEN=generate_your_secure_random_token_here
# 强制拦截未配置令牌时的外部网络访问（生产/联调环境统一建议设为 1；1=直接返回 401/403，0=仅记录安全告警）
ENFORCE_REMOTE_AUTH=1
# CORS 跨域白名单（逗号分隔）。不配置时默认仅放行本机控制台来源，
# 生产环境严禁使用 *（任意站点即可对本机控制台发起控制类请求）。
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:18080,app://desktop-ui

# ---------------------------------------------------------------------------
# 录制产物保留策略（7x24 商用必需，防止磁盘耗尽）
# ---------------------------------------------------------------------------
# 三个条件满足其一即触发回收，始终优先删除最旧的切片：
#   超龄天数 / 切片数量上限 / 总体积上限
# 服务启动时执行一次，并在运行期按 SWEEP_INTERVAL 周期复查。
# 正在录制中的切片永不被回收；records_index.json 索引文件受豁免。
LIVE_AGENT_RECORDING_RETENTION_DAYS=7
LIVE_AGENT_RECORDING_MAX_COUNT=200
LIVE_AGENT_RECORDING_MAX_TOTAL_MB=5120
# 周期复查间隔（分钟）；设为 0 仅关闭自动清理（首次启动仍会按上限回收）
LIVE_AGENT_RECORDING_SWEEP_INTERVAL_MIN=60

# ---------------------------------------------------------------------------
# 直播运营关键开关
# ---------------------------------------------------------------------------
# 单场直播大模型 Token 消费熔断预算（默认 300000，超出后进入节能兜底）
# LIVE_AGENT_MAX_SESSION_TOKENS=300000
# 0-Token 节能冷场轮播（默认 true：弹幕冷场时改用本地叫卖模板，不消耗 LLM API）
# LIVE_AGENT_ECO_MODE=true
# RTMP 断线自愈重连看门狗最大次数（指数退避 1s→2s→…→15s，默认 10）
# LIVE_AGENT_RTMP_MAX_RECONNECTS=10
# 关闭神经唇形权重与 ASR 引擎的自动后台下载（离线/隔离环境设 1；默认 0 自动补齐）
# LIVE_AGENT_DISABLE_AUTO_DOWNLOAD=0

# ---------------------------------------------------------------------------
# 云端 GPU Sidecar 节点（轻薄本/核显用户推荐配置）
# ---------------------------------------------------------------------------
# 云端渲染节点 WebSocket 地址（形如 wss://your-tunnel.example.com/ws/render-v3）
# CLOUD_GPU_URL=
# 云端渲染节点访问凭证（无鉴权的私有节点可留空）
# CLOUD_GPU_KEY=
