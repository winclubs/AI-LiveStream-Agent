{
  "name": "ai-livestream-agent-desktop",
  "productName": "AI-LiveStream-Agent 专业版",
  "version": "2.0.1",
  "description": "AI 互动直播系统桌面控制台 (Electron 桌面壳 + 本地 Python 引擎托管)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "dist:dir": "electron-builder --dir",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:all": "electron-builder --win --mac --linux --publish always",
    "prepublishOnly": "node scripts/verify_release_contract.js"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "build": {
    "appId": "com.ailive.agent",
    "productName": "AI-LiveStream-Agent",
    "copyright": "Copyright (c) 2026 AI-LiveStream-Agent",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "autoupdate.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/python",
        "to": "python",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "../../server",
        "to": "server",
        "filter": [
          "**/*",
          "!**/tests/**",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/requirements-test.txt"
        ]
      },
      {
        "from": "../../scripts",
        "to": "scripts",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/examples/**"
        ]
      },
      {
        "from": "../../launcher.py",
        "to": "launcher.py"
      },
      {
        "from": "../../version.json",
        "to": "version.json"
      },
      {
        "from": "../../README.md",
        "to": "README.md"
      },
      {
        "from": "../../.env.example",
        "to": ".env.example"
      },
      {
        "from": "../../docs",
        "to": "docs",
        "filter": [
          "**/*",
          "!**/superpowers/**",
          "!**/notes/**"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "publisherName": "AI-LiveStream-Agent",
      "verifyUpdateCodeSignature": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AI-LiveStream-Agent 专业版",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.video",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "sign": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "maintainer": "AI-LiveStream-Agent",
      "desktop": {
        "StartupWMClass": "AI-LiveStream-Agent"
      }
    },
    "publish": [
      {
        "provider": "generic",
        "url": "${env.UPDATE_SERVER_URL}"
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "compression": "maximum",
    "removePackageScripts": true
  }
}
