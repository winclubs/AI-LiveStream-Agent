# 文本文件在仓库内统一以 LF 存储 (跨平台协作与 Linux CI 友好)
* text=auto

# Windows 脚本检出时保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件禁用换行与文本转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.wav binary
*.mp3 binary
*.npy binary
*.pkl binary
*.db binary
*.zip binary
*.exe binary
*.dll binary
*.pyd binary
*.pdf binary
